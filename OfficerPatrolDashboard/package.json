{
  "name": "officer-patrol-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted full-stack dashboard for officer patrol summaries from Excel uploads",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "vite client/",
    "build": "vite build client/",
    "start": "node server/index.js",
    "test:parser": "node server/utils/parseExcel.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.10",
    "recharts": "^2.13.0",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "zustand": "^5.0.0"
  }
}
